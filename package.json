{
  "name": "carbikekharido-module-01-identity",
  "version": "0.1.0",
  "private": true,
  "description": "CarBikeKharido.com — Module 1: Progressive Registration & Identity (Anonymous-First). Bilingual (EN/HI) demo.",
  "scripts": {
    "dev": "node -r ./scripts/patch-fs-fat32.js ./node_modules/next/dist/bin/next dev",
    "build": "node -r ./scripts/patch-fs-fat32.js ./node_modules/next/dist/bin/next build",
    "start": "node -r ./scripts/patch-fs-fat32.js ./node_modules/next/dist/bin/next start",
    "lint": "node -r ./scripts/patch-fs-fat32.js ./node_modules/next/dist/bin/next lint",
    "sync:once": "node scripts/run-sync-once.mjs",
    "sync:cron": "node scripts/cron-vehicle-sync.mjs",
    "catalog:build": "node scripts/build-india-catalog.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:migrate": "node scripts/apply-prisma-migration.mjs",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:migrate:status": "prisma migrate status",
    "test:vehicles-schema": "ts-node --project tsconfig.scripts.json scripts/test-vehicles-schema.ts",
    "test:bike-specs": "ts-node --project tsconfig.scripts.json scripts/test-bike-specs.ts",
    "test:rider-fit": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/test-rider-fit.ts",
    "specs:bikes": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/scrape-bike-specs.ts",
    "queue:worker": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/scraping-worker.ts",
    "queue:enqueue": "node scripts/enqueue-scrapes.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@supabase/supabase-js": "^2.110.9",
    "bull": "^4.16.5",
    "ioredis": "^5.11.1",
    "mysql2": "^3.11.0",
    "next": "14.2.35",
    "puppeteer": "^25.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "redis": "^6.1.0",
    "sharp": "^0.33.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bull": "^3.15.9",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.4.2",
    "node-cron": "^3.0.3",
    "postcss": "^8.4.40",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
