# Copy this file to .env.local and fill in your local MySQL credentials.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=carbikekharido

# Prisma CLI (mysql://USER:PASSWORD@HOST:PORT/DB_NAME — URL-encode special chars in password)
DATABASE_URL=mysql://root:password@127.0.0.1:3306/carbikekharido

# --- Aggregator sync (catalog ingestion) ---
# Leave AGGREGATOR_API_URL empty to use the built-in mock catalog in development.
AGGREGATOR_API_URL=
AGGREGATOR_API_KEY=
AGGREGATOR_TIMEOUT_MS=30000

# Cron + manual sync auth (required for /api/cron/sync-vehicles)
CRON_SECRET=change-me-to-a-long-random-string

# Image storage: "local" writes to public/uploads/vehicles; "s3" for production
SYNC_STORAGE_MODE=local
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
AWS_S3_PREFIX=vehicles
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SYNC_CDN_BASE_URL=

# Self-hosted cron script (scripts/cron-vehicle-sync.mjs)
SYNC_API_BASE_URL=http://localhost:3000
SYNC_CRON_EXPR=0 2 * * *

# --- Supabase Storage (vehicle listing photos/videos) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Bucket name (create in Storage → New bucket → public read)
# Default bucket: vehicle-listings

# --- Scraping alerts (optional) ---
ALERT_EMAIL_TO=ops@carbikekharido.com
ADMIN_EMAIL=
SLACK_WEBHOOK_URL=
SLACK_ALERTS_ENABLED=false
# Storage quota for alert threshold (GB)
STORAGE_QUOTA_GB=10

# --- Wishlist email alerts (optional — logs to console when unset) ---
RESEND_API_KEY=
EMAIL_FROM=CarBikeKharido <alerts@carbikekharido.com>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Redis / Bull job queue (Upstash recommended for production) ---
# Upstash: Redis → Details → copy rediss:// URL
REDIS_URL=
# Worker timezone for 6-hour scrape schedule (12AM, 6AM, 12PM, 6PM IST)
TZ=Asia/Kolkata
